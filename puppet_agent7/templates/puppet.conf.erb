[main]
certname = <%= @certname %>
server = <%= @server %>
<% if @installed_major >= 7 -%>
serverport = <%= @serverport %>
<% else -%>
masterport = <%= @serverport %>
<% end -%>
ca_server = <%= @ca_server %>
ca_port = <%= @ca_port %>
certificate_revocation = <%= @certificate_revocation %>
dns_alt_names = <%= @certname %>,<%= @private_ip %>,<%= @server %>
